{
  "expo": {
    "name": "Linkloom",
    "slug": "linkloom",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "android": {
      "package": "com.brandside.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF16A"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Linkloom to access your photos so you can choose a creator profile picture."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "a37e434c-75c0-4553-be55-6004efa8257b"
      }
    }
  }
}
